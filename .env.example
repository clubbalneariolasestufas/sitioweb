# ============================================================
# Club Balneario Las Estufas: variables de entorno
# Copie este archivo como .env para trabajar en su computadora.
# NUNCA suba el archivo .env a GitHub (ya está en .gitignore).
# ============================================================

# ---------- A. VARIABLES PARA NETLIFY ----------
# Dónde: Netlify > Project configuration > Environment variables.
# Marque como secretas las que dicen (secreto).

SITE_URL=https://su-sitio.netlify.app
CLUB_EMAIL=clubbalneariolasestufas@gmail.com      # destino de avisos de reservas
EVENTOS_EMAIL=                                   # correo de Lexie: solicitudes de eventos y resumen diario (si falta, usa CLUB_EMAIL)
CALENDARIO_TOKEN=                                # 24+ caracteres aleatorios: enlace privado de Google Calendar
SINPE_NUMBER=6003-4009                            # SINPE Móvil de la entrada (cocina/restaurante tiene otro)
ORDEN_VENCE_MIN=120                               # minutos que tiene un cliente para pagar

MONGODB_URI=                                      # (secreto) cadena de conexión de MongoDB Atlas
MONGODB_DB=las_estufas

# Texto aleatorio de 32 caracteres o más. Genere uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si lo cambia, todos los boletos ya emitidos dejan de ser válidos.
QR_SIGNING_SECRET=                                # (secreto)

# Dos PIN del panel del personal, guardados como hash. Genere cada valor con:
#   node scripts/hash-pin.mjs 482913
GATE_PIN_HASH=                                    # (secreto) PIN de puerta: escanear, buscar, dar ingreso
ADMIN_PIN_HASH=                                   # (secreto) PIN de administración: además aprueba pagos a mano

# Envío del boleto por correo (opcional: sin esto el cliente igual ve sus QR en pantalla).
# Gmail personal: exige verificación en 2 pasos y una contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=clubbalneariolasestufas@gmail.com
SMTP_APP_PASSWORD=                                # (secreto) contraseña de aplicación de 16 caracteres
MAIL_FROM="Club Las Estufas <clubbalneariolasestufas@gmail.com>"

# Loyverse (punto central de venta). Los identificadores se obtienen con:
#   LOYVERSE_TOKEN=xxxx node scripts/loyverse-ids.mjs
LOYVERSE_TOKEN=                                   # (secreto) Back Office > Integraciones > Tokens de acceso
LOYVERSE_STORE_ID=                                # tienda del balneario
LOYVERSE_PAYMENT_TYPE_ID=                         # tipo de pago "SINPE web"
LOYVERSE_VARIANT_DIA=                             # artículo "Pase del día"
LOYVERSE_VARIANT_CERVECERO=                       # artículo "Pase Cervecero"
LOYVERSE_VARIANT_ECONOMICO=                       # artículo "Pase Económico"

# ---------- B. EQUIPO LECTOR DE PAGOS (Raspberry) ----------
# No van en Netlify. Están en lector-sinpe/.env.example y se copian al Raspberry.
