# Lector SINPE: copie este archivo como .env en el Raspberry y complete los valores.

# Base de datos (usuario de Atlas con permiso de lectura y escritura SOLO en la base las_estufas)
MONGODB_URI_LECTOR=
MONGODB_DB=las_estufas

# Módem USB
MODEM_PORT=/dev/ttyUSB0          # mejor la ruta fija: ls /dev/serial/by-id/
MODEM_BAUD=115200
SIM_PIN=                         # solo si el chip pide PIN
SMS_REMITENTES=70701222          # remitente de los SMS de SINPE (el que aparece en el celular: 7070 1222)

# Correo dedicado a los avisos del banco (confirmación secundaria)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=               # contraseña de aplicación de Gmail (16 caracteres)
IMAP_FOLDER=INBOX
IMAP_FROM_FILTER=                # dirección o dominio del banco, por ejemplo @banco.fi.cr
IMAP_EXIGIR_DKIM=true

# 1 = basta el SMS o el correo para aceptar un pago.
# 2 = el pago solo se acepta cuando llegan los dos avisos con el mismo comprobante y monto (más seguro,
#     pero exige que el banco ponga el mismo número de comprobante en el SMS y en el correo).
FUENTES_MINIMAS=1
